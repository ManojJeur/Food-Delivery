# Local PostgreSQL container. Copy this file to .env and replace both passwords.
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# Least-privilege login used by the application services.
DB_USERNAME=fooddelivery_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_PORT=5432

# User Service database connection (when starting the service from STS/Maven)
DB_HOST=localhost
DB_NAME=user_db
RESTAURANT_DB_NAME=restaurant_db
